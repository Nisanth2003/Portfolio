
# Copy to .env.local for local development. Never commit the real values.
#
# Without any of these, `npm run dev` uses src/data/projects.fallback.json, so you
# can work on the site with no credentials at all.

# ---- Option A: private sheet via service account (recommended) ----------------
# The long id from the sheet URL, between /d/ and /edit
SHEET_ID=

# The entire service-account JSON key file, on one line. Base64 is also accepted.
# Locally, easier: GOOGLE_SERVICE_ACCOUNT_JSON=$(cat service-account.json)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional. Defaults to Projects!A1:ZZ2000 — change only if you rename the tab.
SHEET_RANGE=Projects!A1:ZZ2000

# ---- Option B: published-to-web CSV (simpler, NOT private) --------------------
# Anyone with this URL can read the sheet. Only use if you accept that.
# SHEET_CSV_URL=

# ---- Site ---------------------------------------------------------------------
# Set automatically by the deploy workflow. Only needed locally for absolute URLs.
# NEXT_PUBLIC_SITE_URL=https://nisanth2003.github.io
# NEXT_PUBLIC_BASE_PATH=/3d_portfolio
